{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lrm-fastapi",
      "runtimeExecutable": "py/.venv/bin/python3",
      "runtimeArgs": ["-m", "uvicorn", "--app-dir", "py", "api.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "lrm-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "rn/frontend", "run", "web", "--", "--port", "8081"],
      "port": 8081
    }
  ]
}
