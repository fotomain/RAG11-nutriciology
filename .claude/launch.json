{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lrm-fastapi",
      "runtimeExecutable": ".venv/bin/python3",
      "runtimeArgs": ["-m", "uvicorn", "stage8_fastapi.main:app", "--port", "8000"],
      "port": 8000
