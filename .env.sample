# RAG11 Nutrition — environment variables
# Fill in the blank values below yourself (never share these in chat).
# Loaded via python-dotenv: `from dotenv import load_dotenv; load_dotenv()`

# Supabase project (from the project overview doc)
PUBLIC_SUPABASE_URL=https://XXX.supabase.co
PUBLIC_SUPABASE_ANON_KEY=XXX

# Prefer the service_role key for backend ingestion (Stage 1.2) — it bypasses
# RLS cleanly. Falls back to the anon key above if left blank, which only
# works once you've added permissive insert/select RLS policies for it.
# https://supabase.com/dashboard/project/czgrxgzdmodkkmbmraub/settings/api-keys
SUPABASE_SERVICE_ROLE_KEY=XXX

# Anthropic Claude API key
ANTHROPIC_API_KEY=XXX

# Voyage AI API key (embeddings)
VOYAGE_API_KEY=XXX

# Google AI API key (Gemini)
GOOGLE_AI_API_KEY=XXX

