# RAG11 Nutrition — environment variables
# Fill in the blank values below yourself (never share these in chat).
# Loaded via python-dotenv: `from dotenv import load_dotenv; load_dotenv()`

# Supabase project (from the project overview doc)
PUBLIC_SUPABASE_URL=https://XXX.supabase.co
PUBLIC_SUPABASE_ANON_KEY=XXX

# Prefer the service_role key for backend ingestion (Stage 1.2) — it bypasses
# RLS cleanly. Falls back to the anon key above if left blank, which only
# works once you've added permissive insert/select RLS policies for it.
# https://supabase.com/dashboard/project/czgrxgzdmodkkmbmraub/settings/api-keys
SUPABASE_SERVICE_ROLE_KEY=XXX

# Anthropic Claude API key
ANTHROPIC_API_KEY=XXX

# Voyage AI API key (embeddings)
VOYAGE_API_KEY=XXX

# Google AI API key (Gemini)
GOOGLE_AI_API_KEY=XXX

# RAG technique feature flags (see reusable_code/config.py) -- each
# defaults to True if left unset/commented out here. Set any to False to
# make ask_question() fall back to that technique's simplest variant
# (plain vector search / no expansion / no query splitting / no HyDE)
# with no code changes.
USE_HYBRID_SEARCH=True
USE_PARENT_CHUNK_EXPANSION=True
USE_MULTI_QUERY_QUESTION_SPLITTING=True
USE_HYPOTHETICAL_DOCUMENT_EMBEDDING=True

# Language of every answer, whatever language/script the question is written in (EN, FR, DE, ES, HI, ...).
SPEAKING_LANGUAGE=EN

# Stage 1.1: which pages of each PDF get their TEXT extracted (a fast smoke-test run/window).
# Section boundaries still come from the whole PDF. Unset = 100 pages from page 1. Use NONE for a full, real run.
MAX_NUMBER_OF_PAGES_TO_USE=100

# Stage 1.1: 1-based page to start extracting text from. Unset = 1 (the start of the PDF). Combine with
# MAX_NUMBER_OF_PAGES_TO_USE to select one page window, e.g. START_PAGE_NUMBER=303 + MAX_NUMBER_OF_PAGES_TO_USE=10
# extracts pages 303-312 only.
START_PAGE_NUMBER=1

# Google Drive folder with the LRM source PDFs (stage3_1_lrm_data/download.py)
LRM_SOURCES_FOLDER=https://drive.google.com/drive/folders/1EgkTnENMwHpU83Emux67CHSbVR239hRW?usp=drive_link

# Stage 3.1a OCR (stage3_1_lrm_data/recognize.py): which vision backend recognises each page.
# ocr_with_google (default) uses GOOGLE_AI_API_KEY above.
# ocr_with_aws uses Claude on AWS Bedrock via the AWS_* keys below -- needs Bedrock model
# access enabled for that Claude model in the AWS console first (Bedrock > Model access).
OCR_PROVIDER_NAME=ocr_with_google

# Only needed when OCR_PROVIDER_NAME=ocr_with_aws. IAM user needs bedrock:InvokeModel.
AWS_ACCESS_KEY_ID=XXX
AWS_SECRET_ACCESS_KEY=XXX
AWS_REGION=us-east-1
# Exact model id (or inference-profile ARN) from Bedrock's model catalog, e.g.
# "anthropic.claude-sonnet-4-5-20250929-v1:0" or "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
# -- copy it from the console rather than guessing, ids/prefixes vary by region.
BEDROCK_MODEL_ID=XXX
